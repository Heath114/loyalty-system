# Copy to .env and fill in. Never commit .env, certificates or keys.

# Must be HTTPS for Wallet to receive updates.
PUBLIC_URL=https://cards.example.com
PORT=8787
DB_PATH=data/loyalty.db
# Long random string: openssl rand -base64 32. Changing it invalidates every card QR.
APP_SECRET=

# Apple: see docs/APPLE_SETUP.md
APPLE_TEAM_ID=LZ8RFD29KM
PASS_TYPE_ID=
PASS_CERT_PATH=certs/pass.pem
PASS_KEY_PATH=certs/pass.key
PASS_KEY_PASSPHRASE=
WWDR_CERT_PATH=certs/wwdr-g4.pem
# Or inline PEMs instead of paths (newlines written as \n): PASS_CERT_PEM, PASS_KEY_PEM, WWDR_CERT_PEM

# Leave empty until Apple grants the NFC pass entitlement (docs/APPLE_SETUP.md, step 6).
NFC_ENCRYPTION_PUBLIC_KEY=

# Google Wallet: see docs/GOOGLE_SETUP.md. Leave GOOGLE_ISSUER_ID empty for Apple only.
GOOGLE_ISSUER_ID=
GOOGLE_SERVICE_ACCOUNT_PATH=certs/google-service-account.json
# Or the key file's contents inline instead of the path: GOOGLE_SERVICE_ACCOUNT_JSON

# Local development with the stand-in certificates from `npm run dev-certs`:
# PUBLIC_URL=http://localhost:8787
# PASS_TYPE_ID=pass.dev.loyalty
# APPLE_TEAM_ID=DEVTEAM000
# PASS_CERT_PATH=certs/dev-pass.pem
# PASS_KEY_PATH=certs/dev-pass.key
# WWDR_CERT_PATH=certs/dev-wwdr.pem
